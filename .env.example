# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Flask/JWT/MySQL configuration. Generate strong unique secret values in the
# deployment secret manager; never commit production credentials.
FLASK_SECRET_KEY="change-me-in-production"
JWT_SECRET_KEY="change-me-in-production"
JWT_ACCESS_TOKEN_EXPIRES_MINUTES="480"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="skillbridge"
MYSQL_USER="skillbridge"
MYSQL_PASSWORD="change-me-in-production"
# DATABASE_URL takes precedence when supplied.
# DATABASE_URL="mysql+pymysql://skillbridge:password@127.0.0.1:3306/skillbridge"
CORS_ORIGINS="http://localhost:5173"

# Immutable legacy OTP/Mailjet service. Flask proxies only OTP calls to this
# process; do not port or alter its implementation.
LEGACY_OTP_BASE_URL="http://127.0.0.1:3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings. These values are suitable for local Mailpit testing
# (SMTP inbox: http://localhost:8025). Mailpit does not require credentials,
# so SMTP_USER and SMTP_PASS may remain empty. Supply real provider values via
# environment variables or a secret manager in production; never commit them.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="no-reply@skillbridge.gov.in"
